# ── Dependencies (cài lại bằng `npm ci` từ package-lock.json) ──
node_modules/

# ── Build output & cache của Astro/Vite ──
dist/
.astro/
.cache/
*.tsbuildinfo

# ── Hosting / CLI local state (không commit) ──
.netlify/
.vercel/
.wrangler/
.firebase/

# ── Biến môi trường: chỉ commit file mẫu ──
.env
.env.*
!.env.example

# ── Log & debug ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Hệ điều hành / editor ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Tài liệu tham khảo cục bộ, không build/deploy ──
reference/
archive/
