---
import Icon from '../ui/Icon.astro';
const channels = [
  { label: 'Hotline', value: '(+84) 0938.446.465', href: 'tel:+84938446465', icon: 'phone' as const, external: false },
  { label: 'Email', value: 'haitruonginfotech@gmail.com', href: 'mailto:haitruonginfotech@gmail.com', icon: 'mail' as const, external: false },
  { label: 'Zalo', value: 'zalo.me/84938446465', href: 'https://zalo.me/84938446465', icon: 'chat' as const, external: true },
];
const assurances = [
  'Phản hồi trong 15 phút làm việc',
  'Backup đầy đủ trước khi thao tác',
  'Báo giá rõ ràng trước khi bắt đầu sửa',
];
const platforms = ['WordPress', 'OpenCart', 'Shopify', 'Khác'];
---
<section id="contact" class="relative scroll-mt-28 overflow-hidden bg-footer py-20 lg:py-28" aria-labelledby="contact-title">
  <div class="site-container">
    <div data-reveal>
      <div class="hero-orb -right-24 -top-24 opacity-40" aria-hidden="true"></div>
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
        <div>
          <p class="section-eyebrow">Liên hệ</p>
          <h2 id="contact-title" class="section-title mt-5">Website đang lỗi? <span class="text-gradient">Đừng để mất khách hàng.</span></h2>
          <p class="mt-5 text-base leading-7 text-muted sm:text-lg">Gửi yêu cầu ngay — mình sẽ phản hồi trong 15 phút và báo giá rõ ràng trước khi bắt đầu sửa.</p>
          <ul class="mt-8 space-y-3">
            {assurances.map(item => (
              <li class="flex items-start gap-3 text-sm leading-6"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-accent" /><span>{item}</span></li>
            ))}
          </ul>
          <ul class="mt-10 space-y-4" data-stagger>
            {channels.map(channel => (
              <li class="min-w-0" data-reveal>
                <a href={channel.href} class="contact-channel glow-card flex items-center gap-4 p-4" {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <span class="icon-tile h-12 w-12 shrink-0"><Icon name={channel.icon} class="h-6 w-6" /></span>
                  <span class="min-w-0">
                    <span class="block font-mono text-xs tracking-wider text-muted uppercase">{channel.label}</span>
                    <span class="mt-1 block text-sm font-semibold [overflow-wrap:anywhere] sm:text-base">{channel.value.replace('@', '@​')}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal>
          <form class="glow-card !bg-panel p-6 sm:p-8" data-contact-form aria-labelledby="contact-form-title">
            <h3 id="contact-form-title" class="text-xl font-bold tracking-tight">Gửi yêu cầu sửa lỗi</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Điền thông tin bên dưới, mình sẽ liên hệ lại sớm nhất có thể.</p>
            <div class="mt-7 grid gap-5 sm:grid-cols-2">
              <div>
                <label class="form-label" for="cf-name">Tên của bạn</label>
                <input class="form-field" id="cf-name" name="name" type="text" autocomplete="name" placeholder="Nguyễn Văn A" aria-describedby="cf-name-error" />
                <p class="form-error" id="cf-name-error"></p>
              </div>
              <div>
                <label class="form-label" for="cf-phone">Điện thoại / Zalo <span class="req" aria-hidden="true">*</span></label>
                <input class="form-field" id="cf-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="09xx xxx xxx" aria-describedby="cf-phone-error" />
                <p class="form-error" id="cf-phone-error"></p>
              </div>
              <div>
                <label class="form-label" for="cf-email">Email</label>
                <input class="form-field" id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="ban@email.com" aria-describedby="cf-email-error" />
                <p class="form-error" id="cf-email-error"></p>
              </div>
              <div>
                <label class="form-label" for="cf-platform">Nền tảng website</label>
                <div class="relative">
                  <select class="form-field appearance-none pr-10" id="cf-platform" name="platform">
                    {platforms.map(pf => <option value={pf}>{pf}</option>)}
                  </select>
                  <svg class="pointer-events-none absolute top-1/2 right-3.5 h-4 w-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </div>
              </div>
              <div class="sm:col-span-2">
                <label class="form-label" for="cf-website">Địa chỉ website</label>
                <input class="form-field" id="cf-website" name="website" type="url" inputmode="url" autocomplete="url" placeholder="https://tenmiencuaban.com" aria-describedby="cf-website-error" />
                <p class="form-error" id="cf-website-error"></p>
              </div>
              <div class="sm:col-span-2">
                <label class="form-label" for="cf-message">Mô tả sự cố <span class="req" aria-hidden="true">*</span></label>
                <textarea class="form-field" id="cf-message" name="message" rows="4" required placeholder="Website mình đang gặp lỗi..." aria-describedby="cf-message-hint cf-message-error"></textarea>
                <p class="mt-2 text-xs leading-5 text-muted" id="cf-message-hint">Mô tả càng chi tiết, báo giá càng nhanh và chính xác.</p>
                <p class="form-error" id="cf-message-error"></p>
              </div>
            </div>
            <p class="hidden" aria-hidden="true"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" /></p>
            <button type="submit" class="btn btn-primary mt-7 w-full" data-form-submit>
              <svg class="hidden h-4 w-4 animate-spin" data-form-spinner viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.56" /></svg>
              <span data-form-submit-label>Gửi yêu cầu</span>
              <Icon name="arrow-right" />
            </button>
            <p class="mt-4 text-sm leading-6" data-form-status role="status" aria-live="polite" hidden></p>
            <noscript><p class="mt-4 text-sm leading-6 text-muted">Trình duyệt của bạn đang tắt JavaScript — vui lòng liên hệ trực tiếp qua hotline, email hoặc Zalo bên cạnh.</p></noscript>
          </form>
          <div class="glow-card !bg-panel p-8 text-center" data-form-success hidden tabindex="-1">
            <span class="icon-tile mx-auto flex h-14 w-14 rounded-full"><Icon name="check" class="h-7 w-7" /></span>
            <h3 class="mt-5 text-xl font-bold tracking-tight">Đã nhận được yêu cầu của bạn!</h3>
            <p class="mt-3 text-sm leading-7 text-muted">Mình sẽ liên hệ lại trong vòng 15 phút làm việc. Cần gấp hơn? Gọi thẳng hotline hoặc nhắn Zalo bên cạnh.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
