---
import Icon from '../ui/Icon.astro';
const plans = [
  {
    name: 'Theo giờ / theo lỗi', description: 'Phù hợp khi chỉ cần fix 1 lỗi cụ thể, không cam kết dài hạn.',
    prefix: 'Chỉ từ', price: '250k', unit: '/ giờ', cta: 'Gửi lỗi cần sửa', featured: false,
    features: ['Sửa lỗi đơn lẻ (trắng trang, plugin, theme)', 'Báo giá trước khi sửa', 'Bảo hành lỗi sau sửa 7 ngày', 'Hỗ trợ qua Zalo / Email'],
  },
  {
    name: 'Gói Bảo trì Pro', description: 'Khuyên dùng cho website đang kinh doanh. Giữ website chạy ổn định mỗi ngày.',
    prefix: 'Chỉ từ', price: '2 triệu', unit: '/ tháng', cta: 'Đăng ký gói PRO', featured: true,
    features: ['Update core/plugin/theme hằng tuần', 'Backup tự động hằng ngày (30 bản)', 'Giám sát uptime 24/7 & báo cảnh báo', 'Tối ưu tốc độ & bảo mật định kỳ', 'Fix lỗi phát sinh trong gói (≤ 4h/tháng)', 'Phản hồi ưu tiên < 15 phút'],
  },
  {
    name: 'Gói Enterprise', description: 'Dành cho website thương mại điện tử lớn, traffic cao, nhiều chi nhánh.',
    prefix: '', price: 'Liên hệ', unit: '', cta: 'Liên hệ tư vấn', featured: false,
    features: ['SLA cam kết, hợp đồng dịch vụ', 'Kỹ sư phụ trách riêng (dedicated)', 'Hotline ưu tiên 24/7', 'Tư vấn kiến trúc & bảo mật chuyên sâu'],
  },
];
---
<section id="pricing" class="relative scroll-mt-28 overflow-hidden bg-footer py-20 lg:py-28" aria-labelledby="pricing-title">
  <div class="hero-orb left-1/2 top-1/3 -translate-x-1/2 opacity-30" aria-hidden="true"></div>
  <div class="site-container relative">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="section-eyebrow">Bảng giá</p>
      <h2 id="pricing-title" class="section-title text-gradient mt-5">Minh bạch — linh hoạt theo nhu cầu</h2>
      <p class="mt-5 text-base leading-7 text-muted">Trả theo giờ cho sự cố nhỏ, hoặc gói hàng tháng để yên tâm dài hạn.</p>
    </div>
    <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3" data-stagger>
      {plans.map(plan => (
        <article class:list={['glow-card pricing-card relative flex flex-col p-7 sm:p-8', plan.featured && 'is-featured lg:-my-4 lg:py-12']} data-reveal>
          {plan.featured && <p class="absolute -top-3.5 left-7 rounded-full bg-accent px-3 py-1 font-mono text-xs font-medium text-[var(--on-accent)]">Khuyên dùng</p>}
          <h3 class="text-xl font-bold tracking-tight">{plan.name}</h3>
          <p class="mt-3 text-sm leading-6 text-muted">{plan.description}</p>
          <p class="mt-7 flex flex-wrap items-baseline gap-x-2 border-b border-line pb-7">
            {plan.prefix && <span class="text-sm text-muted">{plan.prefix}</span>}
            <span class:list={['price-value text-5xl font-extrabold tracking-tight', plan.featured && 'text-gradient']}>{plan.price}</span>
            {plan.unit && <span class="font-mono text-sm text-muted">{plan.unit}</span>}
          </p>
          <ul class="mt-7 space-y-3.5 text-sm leading-6">
            {plan.features.map(feature => <li class="flex items-start gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-accent" /><span>{feature}</span></li>)}
          </ul>
          <div class="mt-auto pt-9">
            <a href="#contact" class:list={['btn w-full justify-between', plan.featured ? 'btn-primary' : 'btn-secondary']}>{plan.cta} <Icon name="arrow-right" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
