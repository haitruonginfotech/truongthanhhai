# Canonical URL used at build time. Never put secrets in PUBLIC_* variables.
SITE_URL=https://truongthanhhai.com
# Keep false while the landing page is being built.
PUBLIC_INDEXABLE=false

# ============ Form lien he — API route /api/contact (server-side) ============
# Cac bien duoi day la SECRET: khong co tien to PUBLIC_ nen chi ton tai phia server,
# khong bao gio xuat hien trong JS gui cho trinh duyet. KHONG commit file .env vao git.
# Test local: copy file nay thanh `.env`, dien gia tri roi chay `npm.cmd run dev`.
# Khi deploy: khai bao dung ten cac bien nay trong Vercel > Project Settings >
# Environment Variables (khong dung file .env tren Vercel).

# --- Brevo: gui email bao lead (bat buoc de nhan email) ---
# API key dang xkeysib-..., tao tai Brevo > SMTP & API > API Keys (chon API key, khong phai SMTP key)
BREVO_API_KEY=
# Email nguoi gui — PHAI la sender da xac thuc trong Brevo (Settings > Senders)
CONTACT_FROM_EMAIL=
# Hop thu nhan lead
CONTACT_TO_EMAIL=haitruonginfotech@gmail.com

# --- WhatsApp Cloud API: bao lead qua WhatsApp (tuy chon — bo trong neu chua dung) ---
# Token: dung System User token (khong het han); token tam tren dashboard chet sau 24h
WHATSAPP_TOKEN=
# Phone Number ID lay trong Meta App > WhatsApp > API Setup (la ID, khong phai so dien thoai)
WHATSAPP_PHONE_NUMBER_ID=
# So nhan tin, dang quoc te khong dau +
WHATSAPP_TO=84938446465

# --- Google Sheet: luu lead qua webhook Apps Script (tuy chon, xem docs/contact-backend/SETUP.md) ---
SHEETS_WEBHOOK_URL=
